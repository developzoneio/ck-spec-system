{
  "name": "specwright-antigravity",
  "displayName": "Specwright Antigravity Extension",
  "description": "Specwright extension for Antigravity IDE",
  "version": "0.1.0",
  "publisher": "developzoneio",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "specwright.hello",
        "title": "Specwright: Hello"
      },
      {
        "command": "specwright.runReviewer",
        "title": "Specwright: Run Reviewer"
      },
      {
        "command": "specwright.newFeature",
        "title": "Specwright: New Feature"
      },
      {
        "command": "specwright.fixBug",
        "title": "Specwright: Fix Bug"
      },
      {
        "command": "specwright.refactor",
        "title": "Specwright: Refactor"
      },
      {
        "command": "specwright.diff.accept",
        "title": "Accept Changes",
        "icon": "$(check)"
      },
      {
        "command": "specwright.diff.reject",
        "title": "Ask AI to Fix",
        "icon": "$(wand)"
      },
      {
        "command": "specwright.setup",
        "title": "Specwright: Project Setup"
      }
    ],
    "chatParticipants": [
      {
        "id": "specwright.chat",
        "name": "sdgm",
        "description": "Specwright Developer Gemini",
        "isDefault": false,
        "commands": [
          {
            "name": "feature",
            "description": "Start a new feature workflow"
          },
          {
            "name": "bug",
            "description": "Start a fix bug workflow"
          },
          {
            "name": "refactor",
            "description": "Start a refactor workflow"
          },
          {
            "name": "setup",
            "description": "Initialize or update project setup"
          }
        ]
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "specwright.diff.accept",
          "when": "isInDiffEditor && resourceScheme == 'specwright-diff'",
          "group": "navigation@1"
        },
        {
          "command": "specwright.diff.reject",
          "when": "isInDiffEditor && resourceScheme == 'specwright-diff'",
          "group": "navigation@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run build",
    "build": "vite build",
    "watch": "vite build --watch",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^18.15.11",
    "@types/vscode": "^1.75.0",
    "@typescript-eslint/eslint-plugin": "^5.59.0",
    "@typescript-eslint/parser": "^5.59.0",
    "eslint": "^8.38.0",
    "jest": "^30.4.2",
    "prettier": "^2.8.8",
    "ts-jest": "^29.4.11",
    "typescript": "^5.0.4",
    "vite": "^4.3.9"
  },
  "dependencies": {
    "@google/genai": "^2.10.0",
    "gray-matter": "^4.0.3",
    "ignore": "^7.0.5"
  }
}
